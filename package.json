{
  "name": "mapsite",
  "version": "2.2.1",
  "description": "Fetch and parse URLs from local or remote sitemaps, sitemap indexes, RSS/Atom feeds and robots.txt",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "compile": "tsup src/index.ts --format cjs,esm --dts --target node22 --clean",
    "prepack": "npm run compile",
    "release": "scripts/release.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eckhardt-D/mapsite.git"
  },
  "keywords": [
    "sitemap",
    "sitemap.xml",
    "parser",
    "crawler",
    "robots.txt",
    "rss",
    "xml"
  ],
  "author": "Eckhardt <eckhardt@dreyer.com.na>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Eckhardt-D/mapsite/issues"
  },
  "homepage": "https://github.com/Eckhardt-D/mapsite#readme",
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.12.0",
    "proxy": "^2.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "htmlparser2": "^12.0.0",
    "undici": "^8.11.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist/",
    "CHANGELOG.md"
  ],
  "module": "dist/index.mjs"
}
